    },
    "brand": {
      "primary": { "value": "#7C83FF", "comment": "défaut proposé #4F46E5 : 2.97:1 sur le fond, sous le seuil AA (4.5:1) pour du texte ou des liens · #7C83FF = 6.0:1" },
      "secondary": { "value": "#45E3C6", "comment": "défaut proposé #2DD4BF · 12:1 sur le fond" }
